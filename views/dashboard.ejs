<%- include('head') %><div class="pagehead"><div><div class="eyebrow">WORKSPACE</div><h1>Dashboard Video</h1><p>Kelola seluruh pekerjaan pemotongan otomatis.</p></div><a href="/new" class="button primary">+ Tambah Video</a></div><section class="stats"><div class="stat"><span>Total Proyek</span><strong><%= jobs.length %></strong></div><div class="stat"><span>Selesai</span><strong><%= jobs.filter(j=>j.status==='completed').length %></strong></div><div class="stat"><span>Sedang Dikerjakan</span><strong><%= jobs.filter(j=>['queued','downloading','processing','rendering','retrying'].includes(j.status)).length %></strong></div></section><section class="panel"><div class="sectionhead"><h2>Semua Proyek</h2><span>Terbaru dahulu</span></div><div class="tablewrap"><table><thead><tr><th>Nama Film</th><th>Status</th><th>Part</th><th>Progres</th><th>Aksi</th></tr></thead><tbody><% for(const j of jobs){ %><tr><td><strong><%= j.title %></strong><small><%= new Date(j.created_at).toLocaleString('id-ID') %></small></td><td><span class="status <%= j.status %>"><%= j.status %></span></td><td><%= j.part_done %> / <%= j.part_total %></td><td><div class="progress"><div style="width:<%= j.progress %>%"></div></div><small><%= Math.round(j.progress||0) %>%</small></td><td><a class="smallbutton" href="/jobs/<%= j.id %>">Lihat detail</a></td></tr><% } %><% if(!jobs.length){ %><tr><td colspan="5" class="empty">Belum ada video. Tambahkan video pertama untuk mulai.</td></tr><% } %></tbody></table></div></section><%- include('foot') %>
