<%- include('head') %><div class="pagehead"><div><a href="/" class="back">← Dashboard</a><div class="eyebrow">PROJECT DETAILS</div><h1><%= j.title %></h1><p>Proses download, segmentasi, dan render video.</p></div></div><section class="panel"><div class="jobstatus"><div><span class="status <%= j.status %>" id="status"><%= j.status %></span><h2 id="phase"><%= j.phase||'Menunggu worker' %></h2><p id="count"><%= j.part_done %> dari <%= j.part_total %> part</p></div><strong class="percentage" id="percentage"><%= Math.round(j.progress||0) %>%</strong></div><div class="progress wide"><div id="progress" style="width:<%= j.progress %>%"></div></div><% if(j.error){ %><div class="alert"><strong>Pesan proses:</strong> <%= j.error %></div><% } %><div class="actions"><% if(['queued','downloading','processing','rendering','retrying'].includes(j.status)){ %><form method="post" action="/jobs/<%= j.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Batalkan proses</button></form><% } %><% if(['failed','cancelled'].includes(j.status)){ %><form method="post" action="/jobs/<%= j.id %>/retry"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Ulangi proses</button></form><% } %><% if(['completed','failed','cancelled'].includes(j.status)){ %><form method="post" action="/jobs/<%= j.id %>/rerender"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Render part yang hilang</button></form><form method="post" action="/jobs/<%= j.id %>/delete" onsubmit="return confirm('Hapus proyek beserta seluruh hasil dan file sumber?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Hapus proyek</button></form><% } %></div></section><section class="panel"><div class="sectionhead"><h2>Hasil Part (<%= parts.length %>)</h2><% if(parts.length){ %><a class="button primary" href="/jobs/<%= j.id %>/zip">Download semua ZIP</a><% } %></div><% if(parts.length){ %><form method="post" action="/jobs/<%= j.id %>/parts/delete" onsubmit="return confirm('Hapus part terpilih?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="parts"><% for(const p of parts){ %><div class="part"><div class="parttitle"><label class="check"><input type="checkbox" name="parts" value="<%= p.id %>"> PART <%= String(p.part_no).padStart(2,'0') %></label><span><%= (Number(p.bytes)/1048576).toFixed(1) %> MB</span></div><video controls preload="none" playsinline src="/parts/<%= p.id %>/file"></video><div class="partactions"><a href="/parts/<%= p.id %>/file?download=1" class="smallbutton">Download MP4</a></div></div><% } %></div><div class="actions"><button type="button" onclick="const a=[...document.querySelectorAll('input[name=parts]:checked')].map(x=>x.closest('.part').querySelector('.check').textContent.trim().replace(/\D/g,''));if(a.length)location.href='/jobs/<%= j.id %>/zip?parts='+a.join(',');else alert('Pilih minimal satu part')">Download part terpilih (ZIP)</button><button class="danger" type="submit">Hapus part terpilih</button></div></form><% }else{ %><p class="empty">Part belum tersedia. Hasil render akan muncul di sini.</p><% } %></section><script>if(!['completed','failed','cancelled'].includes(<%- JSON.stringify(j.status) %>)){setInterval(async()=>{try{let r=await fetch('/api/jobs/<%= j.id %>');if(!r.ok)return;let j=await r.json();document.getElementById('status').textContent=j.status;document.getElementById('phase').textContent=j.phase||j.status;document.getElementById('count').textContent=j.part_done+' dari '+j.part_total+' part';document.getElementById('percentage').textContent=Math.round(j.progress||0)+'%';document.getElementById('progress').style.width=j.progress+'%';if(['completed','failed','cancelled'].includes(j.status)||j.part_done!==<%= j.part_done %>)location.reload()}catch(e){}},4000)}</script><%- include('foot') %>
